# === Firebase (клиентский SDK) ===
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Firebase Admin SDK (только сервер, НЕ NEXT_PUBLIC_) ===
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Вставляй как есть из JSON-файла, включая -----BEGIN PRIVATE KEY-----
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Telegram Login Widget ===
# Токен от @BotFather; домен сайта должен быть привязан к боту командой /setdomain
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# === TMDB ===
# ВАЖНО: это должен быть именно v4 "API Read Access Token" (длинная
# строка), а не короткий 32-символьный v3 api_key, который сейчас
# захардкожен в index.html (TMDB_KEY='8265bd...'). Это два разных ключа
# с разным форматом авторизации — v3-ключ сюда не подойдёт. Оба
# генерируются на одной странице настроек TMDB (Settings → API).
TMDB_API_READ_ACCESS_TOKEN=

# === Gemini API (Google AI Studio, aistudio.google.com/apikey) ===
GEMINI_API_KEY=

# === Балансеры плеера ===
# Значения ниже — те же токены, что уже используются в текущей живой
# версии сайта (были захардкожены прямо в index.html). KODIK_TOKEN теперь
# нужен только на сервере (используется в app/api/kodik/search) — раньше
# он был виден любому через "просмотр кода страницы", теперь нет.
# Остальные три остаются NEXT_PUBLIC_, т.к. используются для прямого
# построения ссылки на клиенте (как и раньше) — принципиально это ничего
# не меняет по сравнению с текущим сайтом.
KODIK_TOKEN=447d179e875efe8a77b
NEXT_PUBLIC_VIDEOCDN_TOKEN=3i40G5TSECmLF77oAqnEgbx61ZWznfbT
NEXT_PUBLIC_BAZON_TOKEN=j7vGAz9hrFbNHT4cST3e
NEXT_PUBLIC_HDVB_TOKEN=09e5a3a7da1c62406d59d24e0f15e770

# === TURN-сервер для голосового чата (опционально) ===
# Без этого STUN уже даёт звонки у большинства пользователей; TURN нужен
# как резерв для строгих NAT/файрволов. Бесплатные тарифы по регистрации:
# metered.ca, Xirsys, OpenRelay Project.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
